<Application x:Class="FPVTrainingAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FPVTrainingAssistant.ViewModels"
             xmlns:views="clr-namespace:FPVTrainingAssistant.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/Styles/Controls.xaml" /></ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:ImportSessionViewModel}"><views:ImportSessionView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SessionResultViewModel}"><views:SessionResultView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrajectoryViewModel}"><views:TrajectoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

