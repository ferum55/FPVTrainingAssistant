<UserControl x:Class="FPVTrainingAssistant.Views.TrajectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FPVTrainingAssistant.Views.Controls" Language="en-US">
    <UserControl.Resources>
        <Style x:Key="TelemetryLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Margin" Value="0,0,12,7" /></Style>
        <Style x:Key="TelemetryValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
    </UserControl.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding SessionDurationText}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" /></DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="No recommended route is available for this exercise." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding HasNoRoute, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="{Binding TelemetryStatus}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding HasReplayNotice, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <controls:TrajectoryMap Scene="{Binding}" State="{Binding CurrentState, Mode=OneWay}" AutomationProperties.Name="Top-down flight trajectory" />
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,10,0,4">
                    <TextBlock Text="— Recorded trajectory" Foreground="{StaticResource RecordedTrajectoryBrush}" FontSize="11" Margin="0,0,14,6" />
                    <TextBlock Text="- - Recommended route / R points" Foreground="{StaticResource ReferenceRouteBrush}" FontSize="11" Margin="0,0,14,6" />
                    <TextBlock Text="● Current position / heading" Foreground="{StaticResource DroneMarkerBrush}" FontSize="11" Margin="0,0,14,6" />
                    <TextBlock Text="■ Green zone" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,14,6" />
                    <TextBlock Text="■ Yellow zone" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,0,14,6" />
                    <TextBlock Text="■ Red / outside-route warning" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="0,0,14,6" />
                </WrapPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel><TextBlock Text="Current telemetry" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="Time (s)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Column="1" Text="{Binding CurrentState.TimeSec, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="1" Text="X (m)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentState.X, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="2" Text="Y (m)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentState.Y, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="3" Text="Z (m)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentState.Z, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="4" Text="Speed (m/s)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentState.SpeedMps, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="5" Text="Altitude (m)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentState.AltitudeM, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="6" Text="Pitch (deg)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentState.PitchDeg, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="7" Text="Roll (deg)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentState.RollDeg, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="8" Text="Yaw (deg)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CurrentState.YawDeg, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="9" Text="Battery (%)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding CurrentState.BatteryPercent, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="10" Text="Control link (%)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding CurrentState.ControlLinkQualityPercent, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                                <TextBlock Grid.Row="11" Text="Video link (%)" Style="{StaticResource TelemetryLabel}" /><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding CurrentState.VideoLinkQualityPercent, StringFormat={}{0:F2}, TargetNullValue=Not available}" Style="{StaticResource TelemetryValue}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14" Visibility="{Binding HasRouteMetrics, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="Analyzed route metrics" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding GreenTimeText, StringFormat=Green time: {0}}" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding YellowTimeText, StringFormat=Yellow time: {0}}" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding RedTimeText, StringFormat=Red time: {0}}" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding AverageDeviationText, StringFormat=Average deviation: {0}}" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding MaximumDeviationText, StringFormat=Maximum deviation: {0}}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                        <TextBlock Text="Current / recent events" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="Previous 2 seconds" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                        <TextBlock Text="No events in this interval." Style="{StaticResource MutedText}" Visibility="{Binding HasNoRecentEvents, Converter={StaticResource BoolVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentEvents}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="{Binding EventType}" FontSize="12" /><TextBlock Text="{Binding EntityId}" Style="{StaticResource MutedText}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"><StackPanel>
            <DockPanel Margin="0,0,0,9">
                <TextBlock Text="{Binding TimelineText}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Restart" Command="{Binding RestartCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Step back" Command="{Binding StepBackwardCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButton}" Padding="16,6" MinWidth="70" Margin="0,0,6,0">
                        <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></DataTemplate></Button.ContentTemplate>
                    </Button>
                    <Button Content="Step forward" Command="{Binding StepForwardCommand}" Padding="10,6" Margin="0,0,14,0" />
                    <ComboBox ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed, Mode=TwoWay}" Width="70" VerticalContentAlignment="Center" AutomationProperties.Name="Playback speed">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}x}" Foreground="{StaticResource TextBrush}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
            <Slider Minimum="{Binding ReplayStartTimeSec, Mode=OneWay}" Maximum="{Binding ReplayEndTimeSec, Mode=OneWay}" Value="{Binding CurrentTimeSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReplay}" AutomationProperties.Name="Replay timeline" ToolTip="Seek in session-relative seconds. Seeking pauses playback." />
        </StackPanel></Border>
    </Grid>
</UserControl>
