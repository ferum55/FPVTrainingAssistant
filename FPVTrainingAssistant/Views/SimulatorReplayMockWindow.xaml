<Window x:Class="FPVTrainingAssistant.Views.SimulatorReplayMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FPVTrainingAssistant.Views.Controls"
        Title="Simulator Replay Prototype" Width="1400" Height="820" MinWidth="1100" MinHeight="700"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Language="en-US" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style x:Key="HudText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="23" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <DockPanel><TextBlock Text="Mock integration preview" DockPanel.Dock="Right" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" /><TextBlock Text="Simulator Replay Prototype" FontSize="25" FontWeight="SemiBold" /></DockPanel>
            <WrapPanel Margin="0,8,0,4"><TextBlock Text="{Binding SessionId, StringFormat=Session: {0}}" Margin="0,0,20,0" FontSize="12" /><TextBlock Text="{Binding ExerciseType}" Margin="0,0,20,0" FontSize="12" /><TextBlock Text="{Binding SourceSimulator, StringFormat=Source: {0}}" Style="{StaticResource MutedText}" /></WrapPanel>
            <WrapPanel><TextBlock Text="{Binding EnvironmentId, StringFormat=Environment: {0}}" Style="{StaticResource MutedText}" Margin="0,0,20,0" /><TextBlock Text="{Binding ScenarioId, StringFormat=Scenario: {0}}" Style="{StaticResource MutedText}" /></WrapPanel>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding MinimapToggleText}" Command="{Binding ToggleMinimapCommand}" Style="{StaticResource CompactButton}" /><Button Content="{Binding EventLogToggleText}" Command="{Binding ToggleEventLogCommand}" Style="{StaticResource CompactButton}" Margin="0" /></StackPanel>
            <StackPanel Orientation="Horizontal"><Button Content="FPV" Command="{Binding SetFpVModeCommand}" Style="{StaticResource CompactButton}" /><Button Content="Third Person" Command="{Binding SetThirdPersonModeCommand}" Style="{StaticResource CompactButton}" /><TextBlock Text="{Binding CameraMode, StringFormat=Camera: {0}}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" /></StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="220" Padding="14" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="Recorded telemetry" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Telemetry}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,9"><TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="10" /><TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ScrollViewer>
            </Border>
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="240" Padding="12" Margin="12,0,0,0" Visibility="{Binding IsMinimapVisible, Converter={StaticResource BoolVisibility}}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Minimap · X/Y overview" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <controls:ReplayMinimap Grid.Row="1" Scene="{Binding Minimap}" Frame="{Binding MinimapFrame}" AutomationProperties.Name="Replay minimap" />
                    <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="Flight path · dashed route · labeled entities" Style="{StaticResource MutedText}" FontSize="10" /><TextBlock Text="No dynamic entities were recorded." Style="{StaticResource MutedText}" Visibility="{Binding HasNoDynamicEntities, Converter={StaticResource BoolVisibility}}" /><ItemsControl ItemsSource="{Binding DynamicEntities}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,0"><TextBlock Text="{Binding EntityId}" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntityId}" /><TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}" FontSize="10" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Grid>
            </Border>
            <Border Background="#08151C" BorderBrush="#275050" BorderThickness="1" CornerRadius="10" Padding="16" ClipToBounds="True">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="{Binding TimelineText}" DockPanel.Dock="Right" Style="{StaticResource HudText}" /><TextBlock Text="{Binding CameraMode}" FontSize="18" FontWeight="SemiBold" /></DockPanel>
                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding IsFpVMode, Converter={StaticResource BoolVisibility}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="0,4,0,2">
                                <TextBlock Text="{Binding FlightHud}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" />
                                <TextBlock Text="{Binding BatteryHud}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" TextAlignment="Right" />
                            </UniformGrid>
                            <Viewbox Grid.Row="1" MaxHeight="90" Stretch="Uniform" Margin="0,4">
                                <Path Data="M 0,50 L 35,50 M 65,50 L 100,50 M 50,0 L 50,35 M 50,65 L 50,100 M 45,50 L 55,50 M 50,45 L 50,55" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Width="100" Height="100" />
                            </Viewbox>
                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,2,0,4">
                                <TextBlock Text="{Binding LinkHud}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" />
                                <TextBlock Text="{Binding MotionHud}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" TextAlignment="Right" />
                            </UniformGrid>
                        </Grid>
                        <Grid Visibility="{Binding IsThirdPersonMode, Converter={StaticResource BoolVisibility}}">
                            <Path Data="M 0,25 L 220,25 M 0,75 L 220,75 M 0,125 L 220,125 M 30,0 L 30,150 M 110,0 L 110,150 M 190,0 L 190,150" Stroke="#17323E" StrokeThickness="1" Width="220" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Viewbox MaxHeight="120" MaxWidth="160" Margin="0,4,0,26"><Canvas Width="130" Height="100" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform><RotateTransform Angle="{Binding HeadingRotation}" /></Canvas.RenderTransform>
                                <Path Data="M 27,20 L 90,80 M 27,80 L 90,20 M 60,50 L 115,50 L 100,40 M 115,50 L 100,60" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" />
                                <Ellipse Canvas.Left="12" Canvas.Top="5" Width="30" Height="30" Stroke="{StaticResource AccentBrush}" /><Ellipse Canvas.Left="75" Canvas.Top="5" Width="30" Height="30" Stroke="{StaticResource AccentBrush}" />
                                <Ellipse Canvas.Left="12" Canvas.Top="65" Width="30" Height="30" Stroke="{StaticResource AccentBrush}" /><Ellipse Canvas.Left="75" Canvas.Top="65" Width="30" Height="30" Stroke="{StaticResource AccentBrush}" />
                            </Canvas></Viewbox>
                            <TextBlock Text="External view · heading from recorded yaw" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2"><TextBlock Text="{Binding PositionText}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" /><TextBlock Text="{Binding AttitudeText}" Style="{StaticResource HudText}" FontSize="11" LineHeight="14" /><TextBlock Text="{Binding CameraText}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="Technical viewport prototype · no rendered simulator world" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                </Grid>
            </Border>
        </DockPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0" Visibility="{Binding IsEventLogVisible, Converter={StaticResource BoolVisibility}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="96" /></Grid.RowDefinitions>
                <TextBlock Text="Event log · recorded session events" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="No events recorded." Style="{StaticResource MutedText}" Visibility="{Binding HasNoEvents, Converter={StaticResource BoolVisibility}}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Padding="8,5" Margin="0,0,0,3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource InsetBrush}" /><Setter Property="Opacity" Value="0.5" /><Style.Triggers><DataTrigger Binding="{Binding HasOccurred}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#204343" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><WrapPanel><TextBlock Text="{Binding Display.TimeText}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,0,14,0" FontSize="12" /><TextBlock Text="{Binding Display.EventType}" Margin="0,0,14,0" FontSize="12" /><TextBlock Text="{Binding Display.EntityId}" Margin="0,0,14,0" FontSize="12" /><TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource WarningBrush}" FontSize="11" /></WrapPanel><TextBlock Text="{Binding Display.Details}" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0"><StackPanel>
            <DockPanel><TextBlock Text="{Binding TimelineText}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal">
                <Button Content="Restart" Command="{Binding RestartCommand}" Style="{StaticResource CompactButton}" /><Button Content="Step Back" Command="{Binding StepBackwardCommand}" Style="{StaticResource CompactButton}" />
                <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Style="{StaticResource CompactButton}" Background="{StaticResource AccentBrush}" Foreground="#0B2725"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#0B2725" /></DataTemplate></Button.ContentTemplate></Button>
                <Button Content="Step Forward" Command="{Binding StepForwardCommand}" Style="{StaticResource CompactButton}" />
                <ComboBox ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed, Mode=TwoWay}" Width="75" VerticalContentAlignment="Center" AutomationProperties.Name="Prototype playback speed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}x}" Foreground="{StaticResource TextBrush}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel></DockPanel>
            <Slider Minimum="{Binding ReplayStartTimeSec, Mode=OneWay}" Maximum="{Binding ReplayEndTimeSec, Mode=OneWay}" Value="{Binding CurrentTimeSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prototype replay timeline" Margin="0,10,0,0" ToolTip="Seek in session-relative seconds. Seeking pauses playback." />
        </StackPanel></Border>
        <DockPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="10" /><TextBlock Text="{Binding DataSummary}" Style="{StaticResource MutedText}" FontSize="10" /></DockPanel>
    </Grid>
</Window>
